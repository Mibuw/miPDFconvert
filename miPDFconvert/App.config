<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
  </configSections>
  <appSettings>
    <add key="TARGET_APPLICATION" value=""/>    <!-- Set a target application with the pdf as a argument -->
    <add key="CREATE_DOCUMENT_FILES" value="false"/>    <!-- true: keep a copy of each print job as miPDFconvert.ps and miPDFconvert.pdf in %temp% (diagnostics) -->
  </appSettings>
  <log4net>
    <appender name="LogFileAppender" type="log4net.Appender.FileAppender">
      <param name="File" value="${ProgramData}\miPDFconvert\miPDFconvert.log" />
      <param name="AppendToFile" value="true" />
      <!-- MinimalLock: mehrere gleichzeitige Instanzen teilen sich die Logdatei.
           Mit dem exklusiven Standard-Lock loggt die zweite Instanz gar nichts. -->
      <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
      <layout type="log4net.Layout.PatternLayout">
        <param name="Header" value="-------------------------------------------------------------------------------------------&#13;&#10;[Begin.miPDFconvert]&#13;&#10;" />
        <param name="Footer" value="[End.miPDFconvert]&#13;&#10;" />
        <param name="ConversionPattern" value="%d [%t] %-5p %c %m%n" />
      </layout>
    </appender>
    <root>
      <level value="ALL" />
      <appender-ref ref="LogFileAppender" />
    </root>
  </log4net>
</configuration>