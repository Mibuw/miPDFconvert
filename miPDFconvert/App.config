<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <add key="TARGET_APPLICATION" value=""/>    <!-- Set a target application with the pdf as a argument -->
    <add key="CREATE_DOCUMENT_FILES" value="false"/>    <!-- true: keep a copy of each print job as miPDFconvert.ps and miPDFconvert.pdf in %temp% (diagnostics) -->
    <add key="LOG_FILE" value=""/>    <!-- log file or folder, environment variables allowed (e.g. %LOCALAPPDATA%\miPDFconvert); empty: %ProgramData%\miPDFconvert\miPDFconvert.log -->
  </appSettings>
</configuration>
